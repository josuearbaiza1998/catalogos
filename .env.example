# Todo es opcional: sin estas variables la app funciona en "modo local"
# (las fotos y los datos viven en el navegador de la vendedora).

# --- Almacenamiento de imágenes (S3 o compatible: Cloudflare R2, Backblaze B2, MinIO) ---
S3_BUCKET=catalogos-media
S3_REGION=auto
# Para R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (déjalo vacío para AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dominio público del bucket / CDN (sin "/" final). Ej: https://media.tudominio.com
NEXT_PUBLIC_ASSETS_BASE_URL=

# --- Base de datos (PostgreSQL: Neon, Supabase o Vercel Postgres) ---
# El esquema (db/schema.sql) se aplica solo en el primer request.
DATABASE_URL=
